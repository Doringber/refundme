# Public site URL for Open Graph / canonical metadata. Production:
# NEXT_PUBLIC_SITE_URL=https://justrefundme.netlify.app

# Public Supabase (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer the new publishable key; classic anon JWT still works
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # legacy alias

# Server only — never expose to the client / never use NEXT_PUBLIC_ prefix
# Used only by src/lib/supabase/secret.ts (import "server-only")
SUPABASE_SECRET_KEY=sb_secret_...

# Encrypts the stored BuyMe session. Set a dedicated value in production.
# If unset, the server falls back to SUPABASE_SECRET_KEY, and rotating that
# key logs every user out of BuyMe sync.
# BUYME_SESSION_KEY=
# Shared secret for POST /api/cron/buyme-sync (header: x-cron-secret).
# The route stays closed until this is set. Schedule the call yourself
# (about every 6 hours); this repo does not register a host cron.
# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=eyJ...       # legacy alias

# Google login is configured in Supabase Dashboard → Authentication → Providers → Google
# (Client ID + Client Secret from Google Cloud Console). No Google secrets in this app.
# Also add redirect URLs in Supabase Auth → URL Configuration:
#   http://localhost:3000/auth/callback
#   https://YOUR_PRODUCTION_DOMAIN/auth/callback

# Optional legacy OCR key (unused when Netlify AI Gateway / Gemini is available)
DOCUMENT_OCR_API_KEY=

# On Netlify: enable AI Gateway in the site UI (no key in git).
# When Supabase is configured, /api/extract calls Gemini only for a signed-in user.
# Locally, without Supabase, GEMINI_API_KEY still runs vision for demo testing.
# GOOGLE_API_KEY is an accepted alias. GOOGLE_GEMINI_BASE_URL is set by the gateway.
# GEMINI_API_KEY=

# Optional. Used only when OpenStreetMap has no nearby match for a single
# shop name. A BuyMe multi-brand card is matched by one OSM area query
# against the cached brand list (Hebrew aliases included). Searching every
# brand through Google would be one request per brand (about 1,300 for ALL)
# and does not fit the nearby-search budget, so the key is not used for
# those cards. Coordinates are not stored.
# GOOGLE_PLACES_API_KEY=

# Web Push (PWA). Generate a pair with: npx web-push generate-vapid-keys
# The public key is safe in the browser. Set it BEFORE the production build —
# NEXT_PUBLIC_* values are inlined at build time. Use the same public key
# for both variables. VAPID_SUBJECT is a mailto: or https: contact URL.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Email fallback when a person has no push subscription. Both are required
# or the daily job skips email and reports emailUnconfigured.
# RESEND_API_KEY=
# REMINDER_EMAIL_FROM="זיכוי שלי <reminders@your-domain.com>"

# Same CRON_SECRET and x-cron-secret header as BuyMe sync.
# Refreshes the public BuyMe ALL / FOODY / STYLE / TOGETHER brand lists
# (https://buyme.co.il/brands/{id}/options) into buyme_brand_catalogs.
# The lists change during the day; run about every 12 hours:
#   curl -X POST "$SITE_URL/api/cron/buyme-catalogs" -H "x-cron-secret: $CRON_SECRET"
# Apply supabase/migrations/20261027183000_buyme_brand_catalogs.sql yourself.
# Until then the app uses the bundled snapshot and still tries to refresh.
# Call once a day (Jerusalem morning is a good time):
#   curl -X POST "$SITE_URL/api/cron/expiry-reminders" -H "x-cron-secret: $CRON_SECRET"
# This repo does not register that schedule. Apply
# supabase/migrations/20261027120000_household_push_reminders.sql yourself;
# the app does not run it against production.
