# Public Supabase (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer the new publishable key; classic anon JWT still works
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # legacy alias

# Server only — never expose to the client / never commit real values
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...       # legacy alias

# Optional OCR provider key for /api/extract (server-side only)
DOCUMENT_OCR_API_KEY=
