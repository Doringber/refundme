{
  "manifest_version": 3,
  "name": "זיכוי שלי — חיבור BuyMe",
  "version": "1.0.0",
  "description": "אחרי התחברות ל-BuyMe מעביר את החיבור אל זיכוי שלי ומושך את הארנק. לא שומר סיסמה.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://buyme.co.il/*",
    "https://www.buyme.co.il/*",
    "https://justrefundme.netlify.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://buyme.co.il/*", "https://www.buyme.co.il/*"],
      "js": ["content-buyme.js"],
      "type": "module",
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://justrefundme.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-app.js"],
      "type": "module",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
