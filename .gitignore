# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Tesseract OCR cache / optional local traineddata (large)
.tesscache/
public/tessdata/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# BuyMe Playwright session (cookies + JWT) — never commit
.buyme/
buyme_state.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/
